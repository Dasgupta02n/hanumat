{
  "hb-01": "அனுமன்",
  "hb-02": "அஞ்சனி-சூட்",
  "hb-03": "காற்றின் மகன்",
  "hb-04": "பெரும் சக்தி",
  "hb-05": "ரமேஷ்த்",
  "hb-06": "ஃபால்குன்-சகா",
  "hb-07": "பிங்காக்ஷா",
  "hb-08": "அமித்-விக்ரம்",
  "hb-09": "காலவரிசை வரிசை",
  "hb-10": "சீதா-சோக அழிவு",
  "hb-11": "லட்சுமணன் - உயிர் கொடுப்பவன்",
  "hb-12": "தஷ்க்ரீவ-தர்பஹந்தா"
