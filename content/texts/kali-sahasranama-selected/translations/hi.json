{
  "ks-01": "काली — कालस्वरूपा आदि शक्ति।",
  "ks-02": "महाकाली — महाकाल की शक्ति।",
  "ks-03": "भद्रकाली — मङ्गलदा काली।",
  "ks-04": "दक्षिणा — दाहिने पैर आगे — करुणा रूप।",
  "ks-05": "आद्या — आदि शक्ति।",
  "ks-06": "चामुण्डा — चण्ड-मुण्ड संहारिणी।",
  "ks-07": "कपालिनी — कपाल धारिणी।",
  "ks-08": "श्मशानवासिनी — श्मशान निवासिनी — भय हारिणी।",
  "ks-09": "मुण्डमालिनी — मुण्डमाला धारिणी।",
  "ks-10": "चतुर्भुजा — चार भुजा।",
  "ks-11": "मुक्तकेशी — खुले केश।",
  "ks-12": "करालवदना — विकट वदन — असुर-नाश।",
  "ks-13": "शिववामाङ्कसंस्थिता — शिव की वामाङ्क पर।",
  "ks-14": "तारिणी — संसार से तारने वाली।",
  "ks-15": "भैरवी — भैरव की शक्ति।",
  "ks-16": "गुह्यका — गुह्य रूप।",
  "ks-17": "जगन्माता — जगत् की माता।",
  "ks-18": "दयामयी — दया से पूर्ण।",
  "ks-19": "रक्तदन्तिका — रक्तदन्तिका रूप।",
  "ks-20": "सिद्धेश्वरी — सिद्धों की ईश्वरी।",
  "ks-21": "कालरात्रि — काल की रात्रि।",
  "ks-22": "भ्रमराम्बिका — भ्रमर रूप Ambika।",
  "ks-23": "कमला — कमला महाविद्या — सूची मात्र।",
  "ks-24": "तारा — तारा महाविद्या — सूची मात्र।",
  "ks-25": "षोडशी — षोडशी — सूची मात्र।",
  "ks-26": "क्रींबीजधारिणी — क्रीं बीज की अधिष्ठात्री (नाम मात्र)।",
  "ks-27": "नमोऽस्तु ते — इन नामों को नमन — पूर्ण सहस्रनाम यहाँ नहीं।"
}
