{
  "vs-dhyana": "śāntākāraṃ bhujagaśayanaṃ padmanābhaṃ sureśaṃ viśvādhāraṃ gaganasadṛśaṃ meghavarṇaṃ śubhāṅgam lakṣmīkāntaṃ kamalanayanaṃ yogibhirdhyānagamyaṃ vande viṣṇuṃ bhavabhayaharaṃ sarvalokaikanātham",
  "vs-01": "oṃ viśvam namaḥ",
  "vs-02": "oṃ viṣṇuḥ namaḥ",
  "vs-03": "oṃ vaṣaṭkāraḥ namaḥ",
  "vs-04": "oṃ bhūtabhavyabhavatprabhuḥ namaḥ",
  "vs-05": "oṃ pūtātmā namaḥ",
  "vs-06": "oṃ paramātmā namaḥ",
  "vs-07": "oṃ avyayaḥ namaḥ",
  "vs-08": "oṃ puruṣaḥ namaḥ",
  "vs-09": "oṃ sākṣī namaḥ",
  "vs-10": "oṃ kṣetrajñaḥ namaḥ",
  "vs-11": "oṃ akṣaraḥ namaḥ",
  "vs-12": "oṃ yogaḥ namaḥ",
  "vs-13": "oṃ keśavaḥ namaḥ",
  "vs-14": "oṃ nārāyaṇaḥ namaḥ",
  "vs-15": "oṃ mādhavaḥ namaḥ",
  "vs-16": "oṃ govindaḥ namaḥ",
  "vs-17": "oṃ madhusūdanaḥ namaḥ",
  "vs-18": "oṃ trivikramaḥ namaḥ",
  "vs-19": "oṃ vāmanaḥ namaḥ",
  "vs-20": "oṃ śrīdharaḥ namaḥ",
  "vs-21": "oṃ hṛṣīkeśaḥ namaḥ",
  "vs-22": "oṃ padmanābhaḥ namaḥ",
  "vs-23": "oṃ dāmodaraḥ namaḥ",
  "vs-24": "oṃ vāsudevaḥ namaḥ",
  "vs-25": "oṃ rāmaḥ namaḥ",
  "vs-26": "oṃ kṛṣṇaḥ namaḥ",
  "vs-27": "oṃ hariḥ namaḥ",
  "vs-28": "oṃ acyutaḥ namaḥ",
  "vs-29": "oṃ janārdanaḥ namaḥ",
  "vs-30": "oṃ cakrapāṇiḥ namaḥ"
}
